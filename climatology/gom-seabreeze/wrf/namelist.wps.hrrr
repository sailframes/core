! =====================================================================
! namelist.wps.hrrr -- HRRR-DRIVEN 2-domain config (d01 3km + d02 1km) that FITS
! inside the HRRR CONUS grid (the current 9km d01 overran HRRR's SE offshore edge
! by ~57km: SE corner 38.5N,-65.4W -> HRRR i=1812 > 1793). See HRRR_vs_WRF_SAILFRAMES.md
! (W1) + hrrr_fit.py. Driving from HRRR inherits its hourly GSI assimilation (radar/
! aircraft/satellite/mesonet) as the large scale, then downscales to 1km.
!
!   d01 3km 151x151 (~450km) @ 42.3N,-70.5W -- landing pad for HRRR + buffer; FITS HRRR
!   d02 1km  82x76  (race area, = the validated d03 grid) -- the deliverable
! Placement of d02 (i/j_parent_start) -- VERIFY via geogrid (like the LES gate).
! Use MODE=hrrr: run_case.sh stages hourly HRRR F00 analyses + Vtable.raphrrr.
! =====================================================================
&share
 wrf_core         = 'ARW',
 max_dom          = 2,
 start_date       = '2026-07-04_00:00:00', '2026-07-04_00:00:00',
 end_date         = '2026-07-04_18:00:00', '2026-07-04_18:00:00',
 interval_seconds = 3600,          ! hourly HRRR F00 analyses
 io_form_geogrid  = 2,
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  62,   ! d02 in d01 -- VERIFY via geogrid placement
 j_parent_start    =   1,  61,
 e_we              = 151,  82,   ! d01 3km 450km / d02 1km 81km
 e_sn              = 151,  76,
 geog_data_res     = '30s', '30s',
 dx                = 3000,
 dy                = 3000,
 map_proj          = 'lambert',
 ref_lat           =  42.3,
 ref_lon           = -70.5,
 truelat1          =  40.0,
 truelat2          =  45.0,
 stand_lon         = -70.5,
 geog_data_path    = '/path/to/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
/

&metgrid
 fg_name         = 'FILE',
 io_form_metgrid = 2,
/
