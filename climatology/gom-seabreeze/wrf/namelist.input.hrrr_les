! =====================================================================
! namelist.input.hrrr_les -- 4-domain HRRR-driven LES for the BOSTON HARBOR
! ISLANDS race (Hospital Shoals ~42.31 N, -70.95 W). Derived from the validated
! 5-domain namelist.input.les by DROPPING the 9 km d01 and shifting up:
!   d01 3km (HRRR outer) / d02 1km / d03 333m LES / d04 111m LES (gusts).
! Physics arrays = les recipe minus its first (9 km) element. HRRR levels
! (num_metgrid_levels=51 native + soil 9 from wrfprs), interval 3600.
! time_step=15 (3 km outer, CFL<18). Render fills dates + staggered LES starts
! + placement + levels. F-offset init keeps the whole run same-day (no nest
! day-boundary): init from HRRR fXX valid ~race-6h, integrate through the race.
!
! --- LES TURBULENCE SPIN-UP (Rumble II 2026-07-15 post-mortem) -------------------
! That evening the course-point gust factor came out ~1.30 (near the code's own
! LAMINAR? flag of 1.15) while Logan/Castle Island gusted 17-23 kt (GF 1.8-2.2) as
! 925/850 = 24/28 kt mixed down over a hot unstable BL. Root cause was NOT spin-up
! TIME (d03/d04 already start 14/15 Z via --les-d04-hour/--les-d05-hour = ~7 h before
! the 22:30 Z start) but inflow turbulence SEEDING: the nests inherit smooth parent
! inflow and the ~7.5 km upwind fetch to the course is marginal to develop resolved
! eddies from noise alone over water. Three remedies, in order of leverage:
!   1. Cell-perturbation method (Munoz-Esparza) — seed theta perturbations in the
!      relaxation zone so flow arriving over the course is already turbulent. This is
!      the real fix. STAGED, NOT ENABLED: the exact namelist vars differ by WRF build
!      and an unknown var is a FATAL — validate against THIS container's Registry
!      (grep Registry for 'perturb'/'stoch') before uncommenting the &stoch block below.
!   2. Wider d04 (more upwind fetch over the rough/heated city) — needs geogrid
!      re-verification of i/j_parent_start, so do it deliberately, not inline here.
!   3. Belt-and-braces: the dashboard now also carries a momentum-reservoir gust
!      CEILING (surface + alpha*(925/850 - surface)) computed independently of the
!      LES, so a laminar nest can no longer under-warn on gusts. See gust_viz.py.
! =====================================================================

&time_control
 run_days                 = 0,
 run_hours                = 8,                ! F-offset window (rendered)
 run_minutes              = 0,
 run_seconds              = 0,
 start_year               = 2026, 2026, 2026, 2026,
 start_month              = 07,   07,   07,   07,
 start_day                = 15,   15,   15,   15,
 start_hour               = 16,   16,   18,   18,   ! LES nests late-start for spin-up (rendered)
 start_minute             = 00,   00,   00,   00,
 end_year                 = 2026, 2026, 2026, 2026,
 end_month                = 07,   07,   07,   07,
 end_day                  = 16,   16,   16,   16,
 end_hour                 = 00,   00,   00,   00,
 interval_seconds         = 3600,
 input_from_file          = .true., .true., .false., .false.,   ! LES init from parent
 history_interval         = 60, 15, 5, 1,             ! d04 1-min output for gusts
 frames_per_outfile       = 1, 1, 1, 1,
 restart                  = .false.,
 restart_interval         = 1440,
 io_form_history          = 2,
 io_form_restart          = 2,
 io_form_input            = 2,
 io_form_boundary         = 2,
 nwp_diagnostics          = 1,
 ! SST: run/aws/run_case.sh STRIPS sst_update/auxinput4 (static SST in met_em) ->
 ! the LES nests never need wrflowinp_d03/d04 (avoids the sst_update FATAL).
 sst_update               = 1,
 io_form_auxinput4        = 2,
 auxinput4_inname         = "wrflowinp_d<domain>",
 auxinput4_interval       = 1440, 1440, 1440, 1440,
 auxinput4_end_h          = 48,
/

&domains
 time_step                = 15,
 time_step_fract_num      = 0,
 time_step_fract_den      = 1,
 max_dom                  = 4,
 e_we                     = 136,  82,  112,  136,
 e_sn                     = 136,  82,  112,  136,
 e_vert                   = 60, 60, 60, 60,
 p_top_requested          = 10000,
 num_metgrid_levels       = 51,
 num_metgrid_soil_levels  = 9,
 dx                       = 3000, 1000, 333.33333, 111.11111,
 dy                       = 3000, 1000, 333.33333, 111.11111,
 grid_id                  = 1, 2, 3, 4,
 parent_id                = 1, 1, 2, 3,
 i_parent_start           = 1, 55, 23, 34,        ! geogrid-verified iter2 (centered on Hospital Shoals)
 j_parent_start           = 1, 55, 23, 34,
 parent_grid_ratio        = 1, 3, 3, 3,
 parent_time_step_ratio   = 1, 3, 3, 5,           ! d04 = 5 (not 3) for CFL at 111 m
 feedback                 = 0,
 smooth_option            = 0,
 auto_levels_opt          = 2,
 dzbot                    = 15.0,
 dzstretch_s              = 1.3,
 dzstretch_u              = 1.1,
 max_dz                   = 1000.0,
/

&physics
 mp_physics               = 8, 8, 8, 8,
 ra_lw_physics            = 4, 4, 4, 4,
 ra_sw_physics            = 4, 4, 4, 4,
 radt                     = 10, 10, 10, 10,
 sf_sfclay_physics        = 1, 1, 1, 1,           ! MM5-MOST uniform (WRF requires equal; LES-compatible)
 sf_surface_physics       = 3, 3, 3, 3,           ! RUC LSM (HRRR 9-level soil)
 bl_pbl_physics           = 1, 1, 0, 0,           ! YSU parents; PBL OFF on LES nests
 bldt                     = 0, 0, 0, 0,
 cu_physics               = 0, 0, 0, 0,           ! 3km outer is convection-allowing -> no cu param
 cudt                     = 0,
 num_soil_layers          = 9,
 num_land_cat             = 21,
 sf_urban_physics         = 0, 0, 0, 0,
 usemonalb                = .true.,
 fractional_seaice        = 1,
 sst_skin                 = 1,
 isfflx                   = 1,                     ! LES needs surface fluxes
 bucket_mm                = -1,
 bucket_J                 = -1,
/

&fdda
 grid_fdda                = 0, 0, 0, 0,
/

&dynamics
 hybrid_opt               = 2,
 w_damping                = 1,
 diff_opt                 = 2, 2, 2, 2,
 km_opt                   = 4, 4, 2, 2,           ! parents 2D Smagorinsky; LES 3D 1.5-order TKE
 mix_isotropic            = 0, 0, 1, 1,           ! isotropic (3D) mixing on LES
 diff_6th_opt             = 0, 0, 0, 0,
 diff_6th_factor          = 0.12, 0.12, 0.12, 0.12,
 base_temp                = 290.,
 damp_opt                 = 3,
 zdamp                    = 5000., 5000., 5000., 5000.,
 dampcoef                 = 0.2, 0.2, 0.2, 0.2,
 khdif                    = 0, 0, 0, 0,
 kvdif                    = 0, 0, 0, 0,
 non_hydrostatic          = .true., .true., .true., .true.,
 moist_adv_opt            = 1, 1, 1, 1,
 scalar_adv_opt           = 1, 1, 1, 1,
 gwd_opt                  = 0, 0, 0, 0,
 epssm                    = 0.2, 0.5, 0.5, 0.5,
/

! --- LES inflow turbulence seeding (STAGED — validate vs container Registry first) ---
! Uncomment ONLY after confirming these vars exist in this WRF build (an unknown
! namelist var FATALs real.exe/wrf.exe). Cell-perturbation / stochastic theta kick in
! the lateral relaxation zone so the marine nests develop resolved gusts within fetch
! instead of arriving laminar. Then re-check gust_viz Step-5: gust_factor should climb
! well above the 1.15 LAMINAR threshold. See the header post-mortem.
! &stoch
!  num_stoch          = 1,
!  rand_perturb       = 0, 0, 1, 1,        ! perturb the two LES nests only
!  perturb_bdy        = 1,                  ! seed in the boundary/relaxation zone
!  gridpt_stddev_rand_pert = 0.03, 0.03, 0.5, 0.5,
!  lengthscale_rand_pert   = 500., 500., 300., 100.,
!  timescale_rand_pert     = 120., 120., 120., 120.,
! /

&bdy_control
 spec_bdy_width           = 5,
 spec_zone                = 1,
 relax_zone               = 4,
 specified                = .true.,
 nested                   = .false., .true., .true., .true.,
/

&namelist_quilt
 nio_tasks_per_group      = 0,
 nio_groups               = 1,
/
