! =====================================================================
! namelist.wps.les -- 5-domain LES config: adds d04 (333 m) + d05 (111 m)
! LES nests below the 9/3/1 km chain, for gust/oscillation forecasting over
! the EYC race course (~42.46 N, -70.77 W). See wrf/LES_100M_DESIGN.md.
!
! PLACEMENT is provisional (positioned for UPWIND/SE fetch: course in d04's
! downwind N portion, d04 extends SE into d03's interior). VERIFY + adjust
! i/j_parent_start(4,5) from the geogrid placement pass (read geo_em.d04/d05
! centers/extents; d05 centered on course, edges clear d04 relax zone; d04
! clears d03 relax zone). d01-d03 identical to the validated namelist.wps.
! =====================================================================
&share
 wrf_core         = 'ARW',
 max_dom          = 5,
 start_date       = '2024-07-31_00:00:00', '2024-07-31_00:00:00', '2024-07-31_00:00:00', '2024-07-31_00:00:00', '2024-07-31_00:00:00',
 end_date         = '2024-08-02_00:00:00', '2024-08-02_00:00:00', '2024-08-02_00:00:00', '2024-08-02_00:00:00', '2024-08-02_00:00:00',
 interval_seconds = 10800,
 io_form_geogrid  = 2,
/

&geogrid
 parent_id         =   1,   1,   2,    3,    4,
 parent_grid_ratio =   1,   3,   3,    3,    3,
 i_parent_start    =   1,  28,  55,    7,    8,   ! d04 in d03 / d05 in d04 -- VERIFY via geogrid
 j_parent_start    =   1,  30,  37,   34,   60,
 e_we              = 100, 136,  82,  112,  136,   ! d04=333m 37km / d05=111m 15km
 e_sn              = 100, 136,  76,  112,  136,
 geog_data_res     = '30s', '30s', '30s', '30s', '30s',
 dx                = 9000,
 dy                = 9000,
 map_proj          = 'lambert',
 ref_lat           =  42.6,
 ref_lon           = -70.5,
 truelat1          =  40.0,
 truelat2          =  45.0,
 stand_lon         = -70.5,
 geog_data_path    = '/path/to/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
/

&metgrid
 fg_name         = 'FILE',
 io_form_metgrid = 2,
/
