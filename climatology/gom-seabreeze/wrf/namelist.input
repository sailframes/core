! =====================================================================
! namelist.input  --  Gulf of Maine / Mass Bay  9 / 3 / 1 km
! SailFrames sea-breeze downscale.  WRF-ARW v4.x.  RU-WRF-style recipe:
!   MYNN PBL + MYNN sfc layer + RUC LSM + Thompson + RRTMG,
!   coldest-pixel SST as lower boundary via sst_update.
!
! MUST EDIT / VERIFY before running:
!   * dates (match namelist.wps)
!   * num_metgrid_levels  -> depends on DRIVER:
!         GFS 0.25 = 34 (shown) | ERA5 = 38 (typ.) | HRRR = set to HRRR's
!         level count & use the HRRR Vtable in WPS.
!   * e_we/e_sn/parent starts must match namelist.wps EXACTLY.
!   * SST injection: real.exe must see the coldest-pixel SST in met_em
!     (see gom_coldest_pixel_sst_spec.md, "WRF integration").
!
! RUN MODES (same config, swap only the driver in WPS):
!   forecast    -> GFS (or HRRR) ICs/LBCs, run race-morning.
!   hindcast    -> ERA5 ICs/LBCs for the Tactics-Climatology reconstruction;
!                  turn on &fdda spectral nudging on d01 (see below).
! =====================================================================

&time_control
 run_days                 = 0,
 run_hours                = 48,
 run_minutes              = 0,
 run_seconds              = 0,
 start_year               = 2024, 2024, 2024,
 start_month              = 07,   07,   07,
 start_day                = 31,   31,   31,
 start_hour               = 00,   00,   00,
 end_year                 = 2024, 2024, 2024,
 end_month                = 08,   08,   08,
 end_day                  = 02,   02,   02,
 end_hour                 = 00,   00,   00,
 interval_seconds         = 10800,
 input_from_file          = .true., .true., .true.,
 history_interval         = 60, 60, 15,        ! 15-min output on d03 to resolve the front
 frames_per_outfile       = 1, 1, 1,
 restart                  = .false.,
 restart_interval         = 1440,
 io_form_history          = 2,
 io_form_restart          = 2,
 io_form_input            = 2,
 io_form_boundary         = 2,
 ! --- time-varying SST (coldest-pixel composite) ---
 sst_update               = 1,
 io_form_auxinput4        = 2,
 auxinput4_inname         = "wrflowinp_d<domain>",
 auxinput4_interval       = 1440, 1440, 1440,  ! daily SST update
 auxinput4_end_h          = 48,
/

&domains
 time_step                = 45,               ! 9 km: CFL max ~54 s; nests scale by parent_time_step_ratio
 time_step_fract_num      = 0,
 time_step_fract_den      = 1,
 max_dom                  = 3,
 e_we                     = 100, 136, 121,
 e_sn                     = 100, 136, 121,
 e_vert                   = 60, 60, 60,
 p_top_requested          = 10000,            ! 100 hPa (50 hPa needs many more levels)
 num_metgrid_levels       = 34,               ! <-- CHANGE per driver (see header)
 num_metgrid_soil_levels  = 4,
 dx                       = 9000, 3000, 1000,
 dy                       = 9000, 3000, 1000,
 grid_id                  = 1, 2, 3,
 parent_id                = 1, 1, 2,
 i_parent_start           = 1, 28, 52,
 j_parent_start           = 1, 30, 50,
 parent_grid_ratio        = 1, 3, 3,
 parent_time_step_ratio   = 1, 3, 3,
 feedback                 = 0,                ! one-way nesting
 smooth_option            = 0,
 ! --- vertical layering: pack levels near the surface for the shallow
 !     (~500 m-1 km) sea-breeze density current ---
 auto_levels_opt          = 2,
 dzbot                    = 15.0,             ! ~15 m first layer
 dzstretch_s              = 1.3,              ! 1.1 was too gentle -> couldn't reach p_top
 dzstretch_u              = 1.1,              ! 1.05 needed ~70 levels just to reach max_dz
 max_dz                   = 1000.0,
/

&physics
 mp_physics               = 8, 8, 8,          ! Thompson
 ra_lw_physics            = 4, 4, 4,          ! RRTMG LW
 ra_sw_physics            = 4, 4, 4,          ! RRTMG SW
 radt                     = 10, 10, 10,       ! keep equal across domains
 sf_sfclay_physics        = 5, 5, 5,          ! MYNN surface layer (pairs w/ MYNN PBL)
 sf_surface_physics       = 3, 3, 3,          ! RUC LSM (RU-WRF choice). Noah-MP = 4.
 bl_pbl_physics           = 5, 5, 5,          ! MYNN 2.5
 bl_mynn_tkeadvect        = .true.,
 bl_mynn_edmf             = 1, 1, 1,          ! mass-flux (EDMF) on
 bldt                     = 0, 0, 0,
 cu_physics               = 3, 0, 0,          ! Grell-Freitas (scale-aware) d01; explicit d02/d03
 cudt                     = 0,
 num_soil_layers          = 9,                ! RUC LSM (use 4 if you switch to Noah-MP)
 num_land_cat             = 21,               ! MODIS-modified+lakes (set 40 if you build with NLCD)
 sf_urban_physics         = 0, 0, 0,
 usemonalb                = .true.,           ! recommended with sst_update=1
 fractional_seaice        = 1,
 icloud_bl                = 1,
 sst_skin                 = 1,                ! diurnal skin-SST param over water (partial diurnal dTdT recovery)
 bucket_mm                = -1,
 bucket_J                 = -1,
/

&fdda
 ! Spectral/analysis nudging on d01 ONLY -- turn ON for hindcast/climatology
 ! runs so the synoptic stays tied to ERA5 while d02/d03 develop the sea
 ! breeze freely. Leave OFF (0,0,0) for live forecasts.
 grid_fdda                = 0, 0, 0,
 ! gfdda_inname           = "wrffdda_d<domain>",
 ! grid_sfdda             = 0, 0, 0,
 ! fgdt                   = 0, 0, 0,
 ! if_no_pbl_nudging_uv   = 1, 0, 0,
 ! if_no_pbl_nudging_t    = 1, 0, 0,
 ! if_no_pbl_nudging_q    = 1, 0, 0,
 ! k_zfac_uv              = 10,
 ! k_zfac_t               = 10,
 ! k_zfac_q               = 10,
/

&dynamics
 hybrid_opt               = 2,
 w_damping                = 1,
 diff_opt                 = 2, 2, 2,
 km_opt                   = 4, 4, 4,
 diff_6th_opt             = 0, 0, 0,          ! optional: 2 on d03 to damp 2dx noise at 1 km
 diff_6th_factor          = 0.12, 0.12, 0.12,
 base_temp                = 290.,
 damp_opt                 = 3,
 zdamp                    = 5000., 5000., 5000.,
 dampcoef                 = 0.2, 0.2, 0.2,
 khdif                    = 0, 0, 0,
 kvdif                    = 0, 0, 0,
 non_hydrostatic          = .true., .true., .true.,
 moist_adv_opt            = 1, 1, 1,
 scalar_adv_opt           = 1, 1, 1,
 gwd_opt                  = 1, 0, 0,          ! gravity-wave drag on 9 km only
 epssm                    = 0.2, 0.2, 0.5,    ! more vertical damping on the 1 km domain for stability
/

&bdy_control
 spec_bdy_width           = 5,
 spec_zone                = 1,
 relax_zone               = 4,
 specified                = .true.,
 nested                   = .false., .true., .true.,
/

&namelist_quilt
 nio_tasks_per_group      = 0,
 nio_groups               = 1,
/
