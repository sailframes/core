! =====================================================================
! namelist.wps.hrrr_les -- 4-domain HRRR-driven LES for the BOSTON HARBOR
! ISLANDS race (Hospital Shoals ~42.31 N, -70.95 W). Derived from the validated
! 5-domain namelist.wps.les by DROPPING the 9 km d01 and shifting up:
!   d01 = 3 km  (was d02)   HRRR-driven outer
!   d02 = 1 km  (was d03)
!   d03 = 333 m (was d04)   LES nest
!   d04 = 111 m (was d05)   LES nest  -- gusts over the course
! Driven by HRRR (native wrfnat atmos + wrfprs soil); interval 3600.
! PLACEMENT centers each nest ~on Hospital Shoals; VERIFY + adjust
! i/j_parent_start from the geogrid placement gate (geo_em.d03/d04 centers).
! =====================================================================
&share
 wrf_core         = 'ARW',
 max_dom          = 4,
 start_date       = '2026-07-15_16:00:00', '2026-07-15_16:00:00', '2026-07-15_16:00:00', '2026-07-15_16:00:00',
 end_date         = '2026-07-16_00:00:00', '2026-07-16_00:00:00', '2026-07-16_00:00:00', '2026-07-16_00:00:00',
 interval_seconds = 3600,
 io_form_geogrid  = 2,
/

&geogrid
 parent_id         =   1,   1,   2,    3,
 parent_grid_ratio =   1,   3,   3,    3,
 i_parent_start    =   1,  55,  23,   34,   ! centered on Hospital Shoals (geogrid-verified iter2)
 j_parent_start    =   1,  55,  23,   34,
 e_we              = 136,  82, 112,  136,   ! d01 3km 408km / d02 1km 81km / d03 333m 37km / d04 111m 15km
 e_sn              = 136,  82, 112,  136,
 geog_data_res     = '30s', '30s', '30s', '30s',
 dx                = 3000,
 dy                = 3000,
 map_proj          = 'lambert',
 ref_lat           =  42.31,
 ref_lon           = -70.95,
 truelat1          =  40.0,
 truelat2          =  45.0,
 stand_lon         = -70.95,
 geog_data_path    = '/path/to/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
/

&metgrid
 fg_name         = 'FILE',
 io_form_metgrid = 2,
/
