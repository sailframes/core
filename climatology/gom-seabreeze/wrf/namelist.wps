! =====================================================================
! namelist.wps  --  Gulf of Maine / Mass Bay  9 / 3 / 1 km  (RU-WRF-style)
! SailFrames sea-breeze downscale.  WPS v4.x.
!
! BEFORE RUNNING -- edit:
!   * geog_data_path   -> your WPS_GEOG install
!   * start_date/end_date
!   * VERIFY nest placement with plotgrids.exe; nudge i_/j_parent_start
!     so d03 covers Salem Sound + Mass Bay + Cape Ann -> Cape Cod Bay.
!   * geog_data_res: the land-WATER mask is the #1 geography lever for the
!     sea breeze (topo is secondary here -- Cape Ann/Marblehead relief <30 m).
!     The driver RENDERS this line from --geog-detail:
!       modis (default) -> '30s' everywhere (MODIS 21-cat, the validated run)
!       nlcd            -> 'nlcd2011_9s+default' on all 3 domains (9s ~250 m,
!                          NLCD40, sharp coastline + Boston urban class).
!     nlcd needs nlcd2011_ll_9s in WPS_GEOG + an NLCD40 section in the image's
!     VEGPARM.TBL (run/aws/run_case.sh fetches the data + checks the tables).
!     Fallback if the image can't do NLCD: post-geogrid LANDMASK/LU_INDEX
!     surgery on d03 from GSHHG (see SST spec "coastline" + wrf/README).
! =====================================================================
&share
 wrf_core         = 'ARW',
 max_dom          = 3,
 start_date       = '2024-07-31_00:00:00', '2024-07-31_00:00:00', '2024-07-31_00:00:00',
 end_date         = '2024-08-02_00:00:00', '2024-08-02_00:00:00', '2024-08-02_00:00:00',
 interval_seconds = 10800,          ! 3-hourly LBCs (GFS 0.25). Use 3600 if you pull hourly.
 io_form_geogrid  = 2,
/

&geogrid
 parent_id         =   1,   1,   2,
 parent_grid_ratio =   1,   3,   3,
 i_parent_start    =   1,  28,  52,   ! <-- VERIFY with plotgrids.exe
 j_parent_start    =   1,  30,  50,   ! <-- VERIFY with plotgrids.exe
 e_we              = 100, 136, 121,
 e_sn              = 100, 136, 121,
 geog_data_res     = '30s', '30s', '30s',
 dx                = 9000,
 dy                = 9000,
 map_proj          = 'lambert',
 ref_lat           =  42.6,          ! centered just offshore of Mass Bay
 ref_lon           = -70.5,
 truelat1          =  40.0,
 truelat2          =  45.0,
 stand_lon         = -70.5,
 geog_data_path    = '/path/to/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix     = 'FILE',
/

&metgrid
 fg_name         = 'FILE',
 io_form_metgrid = 2,
/

! ---------------------------------------------------------------------
! Domain geometry (as configured):
!   d01  9 km  100 x 100  ~= 900 x 900 km : Gulf of Maine + Georges Bank +
!               Scotian shelf + offshore -> captures synoptic inflow &
!               the offshore SST field that sets the cold side of the dTdT.
!   d02  3 km  136 x 136  ~= 405 x 405 km : New England coast, Cape Cod
!               to southern Maine.
!   d03  1 km  121 x 121  ~= 120 x 120 km : Mass Bay / Salem Sound /
!               Cape Ann -> Cape Cod Bay  (the race area + its geometry).
! One-way nesting (feedback=0 in namelist.input) to avoid feedback noise
! at 1 km, per AEOLUS-RIO practice.
! ---------------------------------------------------------------------
