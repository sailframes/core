! =====================================================================
! namelist.input.hrrr -- HRRR-DRIVEN 2-domain (d01 3km + d02 1km). Matches
! namelist.wps.hrrr. Driver = hourly HRRR F00 analyses (num_metgrid_levels=41,
! Vtable.raphrrr, hourly LBCs) -> inherits HRRR's assimilated state; 1km d02 adds
! the resolution + coldest-pixel SST + local geography HRRR can't. MYNN physics
! (same family HRRR runs). --render (mode=hrrr) fills dates/levels/geog.
! =====================================================================

&time_control
 run_days                 = 0,
 run_hours                = 18,
 run_minutes              = 0,
 run_seconds              = 0,
 start_year               = 2026, 2026,
 start_month              = 07,   07,
 start_day                = 04,   04,
 start_hour               = 00,   00,
 end_year                 = 2026, 2026,
 end_month                = 07,   07,
 end_day                  = 04,   04,
 end_hour                 = 18,   18,
 interval_seconds         = 3600,
 input_from_file          = .true., .true.,
 history_interval         = 60, 15,
 frames_per_outfile       = 1, 1,
 restart                  = .false.,
 restart_interval         = 1440,
 io_form_history          = 2,
 io_form_restart          = 2,
 io_form_input            = 2,
 io_form_boundary         = 2,
 nwp_diagnostics          = 1,
 sst_update               = 1,
 io_form_auxinput4        = 2,
 auxinput4_inname         = "wrflowinp_d<domain>",
 auxinput4_interval       = 1440, 1440,
 auxinput4_end_h          = 18,
/

&domains
 time_step                = 15,               ! 3km d01: CFL max ~18s
 time_step_fract_num      = 0,
 time_step_fract_den      = 1,
 max_dom                  = 2,
 e_we                     = 151,  82,
 e_sn                     = 151,  76,
 e_vert                   = 60, 60,
 p_top_requested          = 10000,
 num_metgrid_levels       = 41,               ! HRRR (rendered per driver)
 num_metgrid_soil_levels  = 9,                ! HRRR RUC soil
 dx                       = 3000, 1000,
 dy                       = 3000, 1000,
 grid_id                  = 1, 2,
 parent_id                = 1, 1,
 i_parent_start           = 1, 62,            ! d02 in d01 -- match namelist.wps.hrrr (VERIFY geogrid)
 j_parent_start           = 1, 61,
 parent_grid_ratio        = 1, 3,
 parent_time_step_ratio   = 1, 3,
 feedback                 = 0,
 smooth_option            = 0,
 auto_levels_opt          = 2,
 dzbot                    = 15.0,
 dzstretch_s              = 1.3,
 dzstretch_u              = 1.1,
 max_dz                   = 1000.0,
/

&physics
 mp_physics               = 8, 8,
 ra_lw_physics            = 4, 4,
 ra_sw_physics            = 4, 4,
 radt                     = 5, 5,
 sf_sfclay_physics        = 5, 5,             ! MYNN (HRRR family)
 sf_surface_physics       = 3, 3,             ! RUC LSM
 bl_pbl_physics           = 5, 5,             ! MYNN 2.5
 bl_mynn_tkeadvect        = .true.,
 bl_mynn_edmf             = 1, 1,
 bldt                     = 0, 0,
 cu_physics               = 3, 0,             ! Grell-Freitas d01 (3km on the edge of CA); explicit d02
 cudt                     = 0,
 num_soil_layers          = 9,
 num_land_cat             = 21,
 sf_urban_physics         = 0, 0,
 usemonalb                = .true.,
 fractional_seaice        = 1,
 icloud_bl                = 1,
 sst_skin                 = 1,
 bucket_mm                = -1,
 bucket_J                 = -1,
/

&fdda
 grid_fdda                = 0, 0,
/

&dynamics
 hybrid_opt               = 2,
 w_damping                = 1,
 diff_opt                 = 2, 2,
 km_opt                   = 4, 4,
 diff_6th_opt             = 0, 0,
 diff_6th_factor          = 0.12, 0.12,
 base_temp                = 290.,
 damp_opt                 = 3,
 zdamp                    = 5000., 5000.,
 dampcoef                 = 0.2, 0.2,
 khdif                    = 0, 0,
 kvdif                    = 0, 0,
 non_hydrostatic          = .true., .true.,
 moist_adv_opt            = 1, 1,
 scalar_adv_opt           = 1, 1,
 gwd_opt                  = 0, 0,
 epssm                    = 0.2, 0.5,
/

&bdy_control
 spec_bdy_width           = 5,
 spec_zone                = 1,
 relax_zone               = 4,
 specified                = .true.,
 nested                   = .false., .true.,
/

&namelist_quilt
 nio_tasks_per_group      = 0,
 nio_groups               = 1,
/
